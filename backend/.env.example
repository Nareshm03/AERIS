# Copy this file to .env and fill in real values. Never commit .env itself.

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
SIGNAL_ENGINE_URL=http://localhost:4001

# YOLO detection microservice (FastAPI, serves your trained best.onnx)
DETECTION_SERVICE_URL=http://localhost:8001

# --- Detection microservice overrides (optional, read by backend/app.py) ---
# MODEL_PATH=./model/best.onnx
# IMG_SIZE=640
# CONF_THRESHOLD=0.4
# BACKEND_ORIGIN=http://localhost:4000
